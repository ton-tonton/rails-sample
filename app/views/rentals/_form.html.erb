<%= form_with(model: rental) do |form| %>
  <% if rental.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(rental.errors.count, "error") %> prohibited this rental from being saved:</h2>

      <ul>
        <% rental.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :book_id, style: "display: block" %>
    <%= form.collection_select :book_id, Book.all.available.or(Book.where(id: form.object.book_id)), :id, :title, prompt: true %>
  </div>

  <div>
    <%= form.label :renter_name, style: "display: block" %>
    <%= form.text_field :renter_name %>
  </div>

  <div>
    <%= form.label :rented_at, style: "display: block" %>
    <%= form.datetime_field :rented_at %>
  </div>

  <div>
    <%= form.label :returned_at, style: "display: block" %>
    <%= form.datetime_field :returned_at %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
